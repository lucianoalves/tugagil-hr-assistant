{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/api/app.py": {
      "maxDuration": 180,
      "excludeFiles": "{tests/**,docs/**,examples/**,.local/**,.env*,.venv/**}"
    }
  },
  "crons": [
    {
      "path": "/internal/maintenance",
      "schedule": "0 3 * * *"
    }
  ],
  "regions": [
    "dub1"
  ]
}
