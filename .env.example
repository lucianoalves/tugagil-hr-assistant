# Local development (do not commit .env)
ENVIRONMENT=development
TUGAAGIL_API_KEY=replace-with-a-random-shared-server-secret
TUGAAGIL_REQUIRE_USER_CONTEXT=true
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key
GEMINI_API_KEY=
LLM_ENABLED=false
LLM_ALLOW_PAID=false
CRON_SECRET=replace-with-a-random-scheduler-secret
WORKER_POLL_SECONDS=2
