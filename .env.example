# Names only. Replace placeholders outside git. The process reads environment
# variables; it does not open this file or .local/pilot-deploy.json.
# Inject locally with: uv run --env-file .env uvicorn src.api.app:app
ENVIRONMENT=development
TUGAAGIL_API_KEY=replace-with-a-random-shared-server-secret
# Optional. Set to the retiring key only during a rotation window, then clear it.
TUGAAGIL_API_KEY_PREVIOUS=
TUGAAGIL_REQUIRE_USER_CONTEXT=true
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key
GEMINI_API_KEY=
LLM_ENABLED=false
LLM_ALLOW_PAID=false
CRON_SECRET=replace-with-a-random-scheduler-secret
# Optional retiring cron secret. Same rotation window as the API key.
CRON_SECRET_PREVIOUS=
WORKER_POLL_SECONDS=2
